{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "string",
      "description": "Config schema version"
    },
    "providers": {
      "type": "object",
      "properties": {
        "folder_provider": {
          "type": "object",
          "description": "Configuration for FolderProvider",
          "properties": {
            "root_dir": {
              "type": "string",
              "format": "uri",
              "description": "Absolute path to root directory for saving experiments."
            },
            "folder_format": {
              "type": "string",
              "description": "Python format string for experiment folder name."
            },
            "filename_format": {
              "type": "string",
              "description": "Python format string for ASDF filename."
            },
            "description_max_length": {
              "type": "integer",
              "description": "Maximum number of characters from the description to include in folder and file names."
            }
          }
        }
      }
    }
  },
  "required": [
    "config_version",
    "providers"
  ]
}